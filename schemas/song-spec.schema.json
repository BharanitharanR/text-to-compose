{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BharanitharanR/text-to-compose/schema/song-spec.schema.json",
  "title": "Text to Song Composer SongSpec",
  "type": "object",
  "required": ["song_spec_version", "metadata", "creative", "lyrics", "arrangement"],
  "properties": {
    "song_spec_version": {"const": "1.0"},
    "metadata": {"type": "object", "required": ["title", "language"], "properties": {
      "title": {"type": "string"}, "language": {"type": "string"},
      "duration_seconds": {"type": "number", "minimum": 1},
      "tags": {"type": "array", "items": {"type": "string"}}
    }, "additionalProperties": true},
    "creative": {"type": "object", "required": ["world", "style", "tempo", "vocals"], "properties": {
      "world": {"type": "string"}, "style": {"type": "string"},
      "tempo": {"type": "number", "minimum": 20, "maximum": 300},
      "time_signature": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}], "minItems": 2, "maxItems": 2},
      "key_or_raga": {"type": "string"},
      "instruments": {"type": "array", "items": {"type": "string"}},
      "vocals": {"type": "object", "required": ["required"], "properties": {
        "required": {"type": "boolean"}, "singer": {"type": "string"}, "narrator": {"type": "string"},
        "language": {"type": "string"}, "range": {"type": "string"}, "technique": {"type": "string"}
      }, "additionalProperties": true},
      "ending": {"type": "string"}
    }, "additionalProperties": true},
    "lyrics": {"type": "object", "required": ["sections"], "properties": {
      "sections": {"type": "array", "items": {"type": "object", "required": ["name", "text"], "properties": {
        "name": {"type": "string"}, "text": {"type": "string"}, "spoken": {"type": "boolean"}
      }, "additionalProperties": true}},
      "approved": {"type": "boolean"}
    }, "additionalProperties": true},
    "arrangement": {"type": "object", "required": ["sections"], "properties": {
      "sections": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {
        "name": {"type": "string"}, "start_beat": {"type": "number", "minimum": 0},
        "end_beat": {"type": "number", "exclusiveMinimum": 0}, "purpose": {"type": "string"},
        "instruments": {"type": "array", "items": {"type": "string"}}
      }, "additionalProperties": true}},
      "motif": {"type": "string"}
    }, "additionalProperties": true},
    "score": {"type": "object", "properties": {"abc": {"type": "string"}, "tracks": {"type": "array"}}, "additionalProperties": true},
    "providers": {"type": "object", "properties": {
      "preferred": {"type": "string"}, "requested_capabilities": {"type": "array", "items": {"type": "string"}}
    }, "additionalProperties": true}
  },
  "additionalProperties": true
}